        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is Foremann?",
            "acceptedAnswer": { "@type": "Answer", "text": "Foremann is a business phone line with an AI that drafts replies to every client text in your voice. You review and hit send. It's built for plumbers, electricians, landscapers, HVAC techs, and contractors who run their own shop." }
          },
