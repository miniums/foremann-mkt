      })} />
    </div>
  </section>

  <!-- ================== FINAL CTA ================== -->
  <section class="big-cta" id="get">
    <div class="wrap">
      <div class="eyebrow">Now on iPhone &amp; Android</div>
      <h2 class="display">Stop leaving money in quotes you never followed up on.</h2>
      <div class="ctas">
        <a href="https://app.foremann.app/signup?plan=starter" class="btn btn-primary">Get your business number</a>
        <a href="#how" class="btn btn-secondary">See how it works</a>
      </div>
      <StoreLinks align="center" />
    </div>
  </section>

  <Footer />
</Layout>
