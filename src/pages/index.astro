          },
          {
            "@type": "Question",
            "name": "Does it work on iPhone and Android?",
            "acceptedAnswer": { "@type": "Answer", "text": "iPhone today — Foremann is live on the App Store. Download it, sign up, and your number is set up inside the app in about five minutes. Android is in the works and we'll ship it as soon as it's ready." }
