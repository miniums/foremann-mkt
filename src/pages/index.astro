          }
        ]
      })} />
    </div>
  </section>

  <!-- ================== FINAL CTA ================== -->
  <section class="big-cta" id="get">
    <div class="wrap">
      <div class="eyebrow">Beta open now</div>
      <h2 class="display">Stop losing jobs to the guy who texted back first.</h2>
      <div class="ctas">
        <a href="#" data-waitlist class="btn btn-primary">Get your business number</a>
        <a href="#how" class="btn btn-secondary">See how it works</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
