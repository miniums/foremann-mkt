---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Support — Foremann" description="Get help with Foremann — business texting and calling for tradespeople. Reach a human, manage billing, or delete your account.">
  <Nav />

  <section class="legal-hero">
    <div class="wrap">
      <div class="eyebrow">Support</div>
      <h1 class="display">We've got your back</h1>
      <p class="lede">
        Foremann is built for people who'd rather be on the job than on the phone with support.
        Email us and a human will get back to you — usually within one business day.
      </p>
    </div>
  </section>

  <section class="legal-body">
    <div class="wrap legal-doc">

      <h2>Email us</h2>
      <p>
        Questions, bugs, billing, feature requests — anything. Write to
        <a href="mailto:support@foremann.app?subject=Foremann%20Support">support@foremann.app</a>
        and we'll reply within one business day. The more detail you can give us
        (what you tapped, what you expected, what happened), the faster we can help.
      </p>

      <h2>Account &amp; billing</h2>
      <p>
        Manage your subscription, update your payment method, or view invoices anytime
        from your account portal at
        <a href="https://app.foremann.app/account.html">app.foremann.app</a>.
        You can also change or cancel your plan there.
      </p>

      <h2>Delete your account</h2>
      <p>
        You can permanently delete your Foremann account and all associated data from
        inside the app: open <strong>Settings</strong>, scroll to the bottom, and tap
        <strong>Delete Account</strong>. This cancels billing, releases your business
        number, and erases your messages, clients, and call history. It can't be undone.
      </p>

      <h2>Privacy &amp; terms</h2>
      <p>
        Read how we handle your data in our <a href="/privacy">Privacy Policy</a>, and the
        rules of the road in our <a href="/terms">Terms of Service</a>.
      </p>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .legal-hero {
    padding: clamp(60px, 8vw, 100px) 0 clamp(30px, 4vw, 50px);
  }
  .legal-hero .display {
    font-size: clamp(44px, 7vw, 80px);
    margin: 18px 0 20px;
  }
  .legal-hero .lede { max-width: 720px; }

  .legal-body {
    padding: clamp(30px, 5vw, 60px) 0 clamp(60px, 9vw, 120px);
  }
  .legal-doc {
    max-width: 760px;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .legal-doc h2 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(22px, 2.6vw, 28px);
    color: var(--text-primary);
    margin: 56px 0 14px;
  }
  .legal-doc h2:first-child { margin-top: 0; }
  .legal-doc p { margin: 0 0 16px; }
  .legal-doc strong { color: var(--text-primary); font-weight: 700; }
  .legal-doc a {
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .legal-doc a:hover { color: var(--rust-dark); }
</style>
