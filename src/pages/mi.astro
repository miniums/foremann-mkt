---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// SE Michigan launch landing page. The printed and texted cards point here
// (foremann.app/mi), so the copy mirrors the card: same headline, same three
// proof points. The offer itself is the SAME site-wide Founding Member offer
// as the homepage pricing section (index.astro) — not a separate regional
// promo — so it draws from the same 25-slot pool and shows the same live
// counter. plan=starter (not pro): the founding rate only exists on Starter.
const SIGNUP = 'https://app.foremann.app/signup?plan=starter&src=mi';
---
<Layout
  title="Never miss another job · Foremann for SE Michigan"
  description="Every text and call in one inbox, with replies drafted in your voice. Founding rate: $39/month, locked in for life — limited to our first 25 customers."
  image="/og-mi.png"
  imageAlt="Foremann. Never miss another job. Business texting and calling for SE Michigan contractors. Founding rate $39/month, locked in for life."
>
  <Nav />

  <section class="mi-hero">
    <div class="wrap">
      <span class="tag"><span class="tag-dot"></span>Metro Detroit &middot; SE Michigan</span>
      <h1 class="display">Never miss another <span class="rust">job.</span></h1>
      <p class="lede">
        Every text and call in one inbox. Foremann drafts the replies in
        your voice, reminds you to follow up, and keeps a running summary
        of every thread so nothing slips when you're on the job.
      </p>

      <ol class="mi-proof">
        <li>
          <span class="mi-num">01</span>
          <span>Client texts at 9pm. Foremann <strong>drafts a reply in your voice.</strong></span>
        </li>
        <li>
          <span class="mi-num">02</span>
          <span>Miss a call. Foremann <strong>auto-transcribes the voicemail</strong> in seconds.</span>
        </li>
        <li>
          <span class="mi-num">03</span>
          <span>Every call and text summarized. <strong>Never lose the thread on a quote.</strong></span>
        </li>
      </ol>

      <div class="mi-offer">
        <div class="mi-offer-tag">Founding rate</div>
        <div class="mi-offer-body">$39/month, locked in for life.</div>
        <div class="mi-offer-fine">
          Limited to our first <span id="founding-cap">25</span> customers. After that, Starter is $49/month.
          <span id="founding-count" hidden> — <span id="founding-remaining">25</span> of <span id="founding-cap-2">25</span> spots left.</span>
        </div>
      </div>
      <script is:inline>
        (function () {
          fetch('https://app.foremann.app/api/v1/_meta/founding-status')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
              if (!data) return;
              var capEls = [document.getElementById('founding-cap'), document.getElementById('founding-cap-2')];
              capEls.forEach(function (el) { if (el) el.textContent = data.cap; });
              var remainingEl = document.getElementById('founding-remaining');
              if (remainingEl) remainingEl.textContent = data.remaining;
              var countEl = document.getElementById('founding-count');
              if (countEl) countEl.hidden = false;
            })
            .catch(function () {
              // Offline or the endpoint's unreachable — the static "limited to our
              // first 25" copy above already stands on its own without a live count.
            });
        })();
      </script>

      <div class="mi-ctas">
        <a href={SIGNUP} class="btn btn-primary">Get the founding rate</a>
      </div>
      <div class="mi-note">
        Takes about 3 minutes. Card on file, cancel anytime, no contracts.
        Your business line works for calls right away — texting activates
        once a one-time carrier registration clears, usually 3–7 business days.
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Single-column conversion page — no phone preview to balance a two-column
     hero, so the content column is centered instead of left-hugging. */
  .mi-hero {
    padding: clamp(48px, 8vw, 88px) 0 clamp(56px, 9vw, 104px);
  }

  .mi-hero :global(.wrap) {
    max-width: 720px;
  }

  .mi-hero .display {
    font-size: clamp(40px, 6.4vw, 68px);
    margin: 18px 0 0;
    max-width: 16ch;
    /* .display runs -0.035em tracking, which closes the word gap enough that
       "another job." collides into one word. Open the word space back up
       without touching the letterforms. */
    word-spacing: 0.12em;
  }

  .mi-hero .lede {
    margin: 20px 0 0;
  }

  /* ---- Proof points ---- */

  .mi-proof {
    list-style: none;
    margin: clamp(32px, 5vw, 44px) 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }

  .mi-proof li {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.45;
  }

  .mi-num {
    flex: none;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--rust);
  }

  .mi-proof strong { font-weight: 800; }

  /* ---- Offer block ---- */

  .mi-offer {
    margin: clamp(32px, 5vw, 44px) 0 0;
    padding: 24px 26px;
    border-radius: 16px;
    border: 2px solid var(--rust);
    background: var(--ink);
    color: var(--bone);
  }

  .mi-offer-tag {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
  }

  .mi-offer-body {
    margin-top: 8px;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.2;
  }

  .mi-offer-fine {
    margin-top: 10px;
    font-size: 14px;
    opacity: 0.78;
  }

  /* The offer block hard-codes an inverted surface. In dark mode --ink/--bone
     swap, so it would render bone-on-bone; and a near-black fill would vanish
     into the near-black page. Use a lifted rust-tinted surface instead so the
     block still reads as a distinct callout. */
  @media (prefers-color-scheme: dark) {
    .mi-offer {
      background: color-mix(in oklab, var(--rust) 12%, #131311);
      color: #F4F0E8;
    }
  }

  /* ---- CTA ---- */

  .mi-ctas {
    margin-top: clamp(28px, 4vw, 36px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .mi-note {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 52ch;
  }
</style>
