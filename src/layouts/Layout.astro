---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  /** Share-card image, root-relative. 1200x630. Resolved to an absolute URL below. */
  image?: string;
  imageAlt?: string;
}
// The title leads with the hook rather than the brand: these links get texted
// to contractors, and in a message preview the title is the bold line that has
// to earn the tap. The description stays under ~155 chars so search results
// don't truncate it, and carries the trade names that branded search misses.
const {
  title = 'Never miss another job · Foremann for contractors',
  description = 'Every text and call in one inbox, with replies drafted in your voice. Built for plumbers, electricians, landscapers and contractors. From $39/mo.',
  image = '/og.png',
  imageAlt = 'Foremann. Never miss another job. Business texting and calling for contractors.'
} = Astro.props;

// og:image must be absolute — Messages, Slack, and the crawlers won't resolve a
// root-relative path. Astro.site is set to https://foremann.app in astro.config.
const imageUrl = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Foremann" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#F4F0E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0A" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Foremann",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "iOS",
      "description": description,
      "downloadUrl": "https://apps.apple.com/us/app/foremann/id6773165667",
      "installUrl": "https://apps.apple.com/us/app/foremann/id6773165667",
      "audience": {
        "@type": "Audience",
        "audienceType": "Tradespeople, plumbers, electricians, landscapers, HVAC technicians, general contractors"
      },
      "offers": [
        { "@type": "Offer", "name": "Starter", "price": "39", "priceCurrency": "USD", "billingDuration": "P1M" },
        { "@type": "Offer", "name": "Pro", "price": "89", "priceCurrency": "USD", "billingDuration": "P1M" }
        // HIDDEN FOR LAUNCH — Crew add-on. Restore alongside the pricing card in index.astro.
        // , { "@type": "Offer", "name": "Crew add-on", "price": "19", "priceCurrency": "USD", "billingDuration": "P1M", "description": "Per-seat add-on to Pro" }
      ]
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
