---
import '../styles/global.css';
import WaitlistModal from '../components/WaitlistModal.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Foremann · The text comes in. The reply is already written.',
  description = 'A business phone line with an AI that drafts every reply in your voice. Built for plumbers, electricians, landscapers, HVAC techs, and contractors. From $29/mo, beta open.'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Foremann" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#F4F0E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0A" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Foremann",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "iOS, Android",
      "description": description,
      "audience": {
        "@type": "Audience",
        "audienceType": "Tradespeople, plumbers, electricians, landscapers, HVAC technicians, general contractors"
      },
      "offers": [
        { "@type": "Offer", "name": "Starter", "price": "29", "priceCurrency": "USD", "billingDuration": "P1M" },
        { "@type": "Offer", "name": "Pro", "price": "69", "priceCurrency": "USD", "billingDuration": "P1M" },
        { "@type": "Offer", "name": "Team", "price": "229", "priceCurrency": "USD", "billingDuration": "P1M" }
      ]
    })} />
  </head>
  <body>
    <slot />
    <WaitlistModal />
  </body>
</html>
